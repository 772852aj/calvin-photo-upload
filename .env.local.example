# --- Service account credentials (split form, recommended) ---
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the value of "private_key" from the JSON file, IN QUOTES, exactly as it appears
# (with the literal \n characters — don't replace them).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIB...\n-----END PRIVATE KEY-----\n"

# Shared Drive ID (from the URL after /folders/)
DRIVE_FOLDER_ID=your-shared-drive-id

# --- Alternative: single JSON blob (if you prefer) ---
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
